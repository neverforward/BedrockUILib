# clangd configuration. The compilation database is generated by xmake:
#   xmake project -k compile_commands
# and must be regenerated with the configuration you build (demo sources need
# --tests=y, otherwise their entries are missing).
Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: None
  Suppress:
    - "-Wmicrosoft-enum-forward-reference"
    - "-Wc++11-narrowing"
    - "-Wc++2b-extensions"
    - "-Wmicrosoft-cast"
CompileFlags:
  # xmake emits clang-cl output flags (-Fo<obj>, -Fd<pdb>). clangd adds the file
  # being compiled itself, so a leftover -Fo makes the driver complain about
  # "multiple source files"; the output path is useless for analysis anyway.
  Remove:
    - "-Fo*"
    - "-Fd*"
  Add:
    - "-ferror-limit=0"
    - '-D__FUNCTION__="dummy"'
    - '-D__clangd__'
